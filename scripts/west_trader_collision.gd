static func add_collision(scene: Node3D):
 var root=Node3D.new();root.name="WestTraderCollision"
 root.position=Vector3(-7,0,2);root.rotation.y=PI/2;scene.add_child(root)
 for entry in BOXES:
  var body=StaticBody3D.new();body.name=entry[0]
  var at=entry[1];var size=entry[2]
  body.position=Vector3(at.x,at.z,-at.y)
  var cs=CollisionShape3D.new();var box=BoxShape3D.new()
  box.size=Vector3(size.x,size.z,size.y);cs.shape=box
  body.add_child(cs);root.add_child(body)
 return root
